{
  "name": "rmcs-backend",
  "version": "2.0.0",
  "description": "Raja Mantri Chor Sipahi - realtime game backend (Bun.serve() + TypeScript, no auth)",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke-test": "bun run scripts/smoke-test.ts",
    "register-admin": "bun run scripts/register-admin.ts",
    "check-cloudflare-usage": "bun run scripts/check-cloudflare-usage.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "module": "src/index.ts"
}
