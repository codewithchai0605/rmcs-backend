{
  "name": "rmcs-backend",
  "version": "1.0.0",
  "description": "Raja Mantri Chor Sipahi - realtime game backend (uWebSockets.js + TypeScript, no auth)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "register-admin": "tsx scripts/register-admin.ts",
    "check-cloudflare-usage": "tsx scripts/check-cloudflare-usage.ts"
  },
  "dependencies": {
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.9.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mongoose": "^5.11.96",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "module": "src/index.ts"
}
